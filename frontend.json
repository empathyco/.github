{
    "extends": [
      "github>empathyco/.github",
      ":semanticCommitTypeAll(chore)",
      "group:allNonMajor",
      "schedule:earlyMondays",
      "npm:unpublishSafe",
      "workarounds:typesNodeVersioning"
    ],
    "rangeStrategy": "bump",
    "ignoreDeps": ["npm", "node"],
    "packageRules": [
        {
            "matchPackagePatterns": ["^@empathyco/"],
            "groupName": "empathyco",
            "description": "Group all @empathyco package updates into a single PR."
        }
    ]
  }
